<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  User LaunchAgent template for gpud (Foreman's supervisor). scripts/install-launchagent.sh
  replaces __PYTHON__, __REPO__ and __HOME__ and bootstraps it into gui/<uid>. launchd does not
  expand "~", so every path here is absolute after installation.

  gpud is CPU-only and holds no GPU memory, so KeepAlive=true (restart however it exits) is
  safe: a hard kill strands nothing. ExitTimeOut 60 is far above what gpud needs to finish its
  current tick and close SQLite after SIGTERM. Background ProcessType is right for a supervisor
  that mostly sleeps. mlx-serve itself is NOT managed here: MLX-Serve.app owns it.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.github.ggaabe.foreman.gpud</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-m</string>
    <string>foreman.daemon</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>__REPO__</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>FOREMAN_HOME</key>
    <string>__HOME__/.foreman</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ExitTimeOut</key>
  <integer>60</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/.foreman/logs/gpud.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.foreman/logs/gpud.stderr.log</string>
</dict>
</plist>
